{
  "$schema_note": "AI-APP 设计 tokens v2（2026-09-04 终版：结构=Apple 明亮留白；Light=Apple蓝#0071e3+白；Dark=护眼低饱和蓝，暖炭底#16130f+暖白字#d9d2c6+强调#6fa3d8，与日间同色相品牌统一）。单一源，经 style-dictionary 生成 Web Tailwind theme 与 NativeWind config。",
  "core": {
    "fontFamily": {
      "ui": ["-apple-system", "BlinkMacSystemFont", "\"SF Pro Text\"", "\"PingFang SC\"", "\"Microsoft YaHei\"", "system-ui", "sans-serif"],
      "mono": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
    },
    "fontSize": { "xs": 12, "sm": 13, "base": 15, "lg": 17, "xl": 20, "2xl": 28, "3xl": 34 },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600 },
    "lineHeight": { "tight": 1.25, "normal": 1.5 },
    "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 24, "3xl": 32 },
    "radius": { "sm": 6, "md": 10, "lg": 14, "pill": 999 },
    "borderWidth": { "hairline": 1 },
    "motion": { "fast": "120ms", "base": "200ms", "slow": "300ms", "ease": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "layout": {
      "contentMax": 980,
      "cardGap": 16,
      "touchTargetMin": 44
    }
  },
  "colors": {
    "light": {
      "bg": "#ffffff",
      "bgSoft": "#f5f5f7",
      "surface": "#ffffff",
      "surfaceSoft": "#f5f5f7",
      "border": "#e5e5ea",
      "borderStrong": "#d1d1d6",
      "text": "#1d1d1f",
      "textSecondary": "#6e6e73",
      "textTertiary": "#aeaeb2",
      "accent": "#0071e3",
      "accentHover": "#0077ed",
      "accentActive": "#006edb",
      "accentSoft": "#e8f1fd",
      "onAccent": "#ffffff",
      "link": "#0066cc",
      "success": "#34c759",
      "warning": "#ff9f0a",
      "danger": "#ff3b30",
      "dangerSoft": "#ffe5e3",
      "shadowCard": "0 1px 2px rgba(0,0,0,0.04), 0 1px 6px rgba(0,0,0,0.04)"
    },
    "dark": {
      "_note": "护眼暗色（2026-09-04 定案）：暖炭底避免纯黑眩光、文字非纯白降亮度、强调=低饱和蓝(与日间 Apple 蓝同色相，品牌统一)",
      "bg": "#16130f",
      "bgSoft": "#1d1914",
      "surface": "#1d1914",
      "surfaceSoft": "#211c16",
      "border": "#2a251d",
      "borderStrong": "#3a342a",
      "text": "#d9d2c6",
      "textSecondary": "#94897a",
      "textTertiary": "#6b6254",
      "accent": "#6fa3d8",
      "accentHover": "#85b4e2",
      "accentActive": "#5f96cf",
      "accentSoft": "#1c2836",
      "onAccent": "#16130f",
      "link": "#8db9e6",
      "success": "#6cbf8b",
      "warning": "#d9b05c",
      "danger": "#d98a7a",
      "dangerSoft": "#3a2620",
      "shadowCard": "0 1px 2px rgba(0,0,0,0.35)"
    }
  },
  "componentHints": {
    "button": "主按钮=pill 胶囊、accent 底、onAccent 文字；次按钮=ghost(透明底+border 描边+text)；触控目标≥44px",
    "card": "surface 底、hairline 边框、radius md~lg、无重阴影；禁止粗边框与大投影",
    "input": "surfaceSoft 底或 surface+边框；聚焦态 accent 描边；placeholder=textTertiary",
    "nav": "透明底、文字导航、品牌 logo 圆角小方块(accent)；移动端底部 Tab 或汉堡由 app 决定",
    "badge": "accentSoft 底 + accent 文字(亮)/accentHover 文字(暗)，radius pill",
    "darkMode": "默认跟随系统 prefers-color-scheme，支持手动切换；Dark 版文字层级靠亮度而非边框"
  }
}
